title: setup
color: orange
position: -792,-1309
---
<<declare $family = 0>>
<<declare $relationshipFamA = 0>>
<<declare $day = 1>>
<<declare $famA_D2_damageCount = 0>>
===

title: start
color: blue
position: -1003,-1311
---
Mailman: *Knock knock*
<<if $family == 1>>
<<jump FamA>>
<<endif>>
===

//FAM A — DAY 1 — BACKPACK (PRISTINE / SLIGHTLY DAMAGED)
title: FamA
when: ($day == 1) && ($package == "backpack") && ($packageState == "Pristine" || $packageState == "SlightlyDamaged")
position: -1637,-804
color: purple
group: FamA && Day1
---
<<setBackground "BGFamA">>
<<once>>
Mailman: Good afternoon! Are you Lina?
<<showCharacter "Lina" "SpeakingTired">>
Lina: That's me. Sofie, your package is here!
<<showCharacter "Lina" "ListeningTired">>
Mailman: Wonderful! I just need your signature right here.
<<showCharacter "Lina" "SpeakingTired">>
Lina: Of course. I don't think I've seen you around before, are you new?
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Yeah, just started actually. Still getting the hang of it. You'll have to be patient with this old man, hahaha.
<<showCharacter "Lina" "LinaSSpeakingTired">>
Lina: Oh, so you are just like Sofie! She's starting at a new school tomorrow.
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Tomorrow? That's exciting! Big day for her then.
-> Mailman: Feeling nervous about it?
<<jump AEn1Day1>>
-> Mailman: Well, I hope this brightens her evening.
<<jump AEnd1Day1>>
<<else>>
...
<<endonce>>
===

title: AEn1Day1
//WARM
position: -1382,-1034
color: green
group: FamA && Day1
---
<<recievePackage true>>
<<set $relationshipFamA += 2>>
<<showCharacter "Lina" "SofieSpeakingTired">>
Sofie: A little... but Mom promised me a brand-new backpack!
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Oh, then this must be it!
<<showCharacter "Lina" "SofieSpeakingTired">>
Sofie: Really? Yay! Can I open it now, please?
<<showCharacter "Lina" "SofieListeningTired">>
-> Mailman: Go ahead, it's all yours.
    <<jump AEnd1Day1>>
-> Mailman: I made sure it brings you good luck on your first day.
    <<jump AEnd2Day1>>
===

title: AEnd1Day1
//NEUTRAL
position: -1381,-872
group: FamA && Day1
color: green
---
<<recievePackage true>>
<<set $relationshipFamA += 1>>
<<showCharacter "Lina" "LinaSSpeakingTired">>
Lina: Thank you so much. Have a nice day.
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: You too. Take care!
<<hideCharacter "Lina">>
<<hideBackground>>
