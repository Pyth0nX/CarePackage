title: setup
position: -269,-1829
color: yellow
---
<<declare $family = 0>>
<<declare $day = 1>>
<<declare $famA_damageCount = 0>>
<<declare $famA_breakCount = 0>>
<<declare $relationshipFamA = 0>>
<<declare $famB_damageCount = 0>>
<<declare $famB_breakCount = 0>>
<<declare $relationshipFamB = 0>>
<<declare $famC_damageCount = 0>>
<<declare $famC_breakCount = 0>>
<<declare $relationshipFamC = 0>>
===

title: start
color: blue
position: -508,-1812
---
Mailman: *Knock knock*
<<if $family == 1>>
<<jump FamA>>
<<elseif $family == 2>>
<<jump FamB>>
<<elseif $family == 3>>
<<jump FamC>>
<<endif>>
===

//FAM A — DAY 1 — WRONG PACKAGE (NOT BACKPACK)
title: FamA
when: ($day == 1) && ($package != "backpack")
color: purple
group: FamA && Day1
position: -1976,-1064
---
//FAM A — DAY 1 — WRONG PACKAGE (NOT BACKPACK)
<<once>>
<<receivePackage false>>
<<setBackground "BGFamA">>
<<showCharacter "Lina" "ListeningTired">>
Mailman: Good afternoon! I have a package for you.
<<showCharacter "Lina" "SpeakingTired">>
Lina: I don't think this is my package. Can you come back when you have mine?
<<showCharacter "Lina" "ListeningTired">>
Mailman: Oh I'm sorry about that, I'll be back with your package.
<<showCharacter "Lina" "SpeakingTired">>
Lina: Okay, thank you. Have a good day!
<<hideCharacter "Lina">>
<<hideBackground>>
<<else>>
<<setBackground "BGFamA">>
<<showCharacter "Lina" "SpeakingTired">>
Lina: Please remember to come back with the right package.
<<hideCharacter "Lina">>
<<hideBackground>>
<<endonce>>
===

//FAM A — DAY 1 — BACKPACK (PRISTINE / SLIGHTLY DAMAGED)
title: FamA
when: ($day == 1) && ($package == "backpack") && ($damage < 1)
position: -1974,-860
color: purple
group: FamA && Day1
---
//FAM A — DAY 1 — BACKPACK (PRISTINE / SLIGHTLY DAMAGED)
<<setBackground "BGFamA">>
<<showCharacter "Lina" "ListeningTired">>
Mailman: Good afternoon! Are you Lina?
<<showCharacter "Lina" "SpeakingTired">>
Lina: That's me. Sofie, your package is here!
<<showCharacter "Lina" "ListeningTired">>
Mailman: Wonderful! I just need your signature right here.
<<showCharacter "Lina" "SpeakingTired">>
Lina: Of course. I don't think I've seen you around before, are you new?
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Yeah, just started actually. Still getting the hang of it. You'll have to be patient with this old man, hahaha.
<<showCharacter "Lina" "LinaSSpeakingTired">>
Lina: Oh, so you are just like Sofie! She's starting at a new school tomorrow.
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Tomorrow? That's exciting! Big day for her then.
-> Mailman: Feeling nervous about it?
    <<jump AEn1Day1>>
-> Mailman: Well, I hope this brightens her evening.
    <<jump AEnd1Day1>>
===

title: AEn1Day1
//WARM
position: -1434,-775
color: green
group: FamA && Day1
---
