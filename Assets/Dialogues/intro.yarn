title: setup
position: -269,-1829
color: yellow
---
<<declare $family = 0>>
<<declare $relationshipFamA = 0>>
<<declare $day = 1>>
<<declare $famA_damageCount = 0>>
<<declare $famB_damageCount = 0>>
===

title: start
color: blue
position: -486,-1829
---
Mailman: *Knock knock*
<<if $family == 1>>
<<jump FamA>>
<<elseif $family == 2>>
<<jump FamB>>
<<elseif $family == 3>>
<<jump FamC>>
<<endif>>
===

//FAM A — DAY 1 — BACKPACK (PRISTINE / SLIGHTLY DAMAGED)
title: FamA
when: ($day == 1) && ($package == "backpack") && ($packageState == "Pristine" || $packageState == "SlightlyDamaged")
position: -1637,-804
color: purple
group: FamA && Day1
---
<<setBackground "BGFamA">>
<<once>>
Mailman: Good afternoon! Are you Lina?
<<showCharacter "Lina" "SpeakingTired">>
Lina: That's me. Sofie, your package is here!
<<showCharacter "Lina" "ListeningTired">>
Mailman: Wonderful! I just need your signature right here.
<<showCharacter "Lina" "SpeakingTired">>
Lina: Of course. I don't think I've seen you around before, are you new?
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Yeah, just started actually. Still getting the hang of it. You'll have to be patient with this old man, hahaha.
<<showCharacter "Lina" "LinaSSpeakingTired">>
Lina: Oh, so you are just like Sofie! She's starting at a new school tomorrow.
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Tomorrow? That's exciting! Big day for her then.
-> Mailman: Feeling nervous about it?
<<jump AEn1Day1>>
-> Mailman: Well, I hope this brightens her evening.
<<jump AEnd1Day1>>
<<else>>
...
<<endonce>>
===

title: AEn1Day1
//WARM
position: -1380,-1060
color: green
group: FamA && Day1
---
<<recievePackage true>>
<<set $relationshipFamA += 2>>
<<showCharacter "Lina" "SofieSpeakingTired">>
Sofie: A little... but Mom promised me a brand-new backpack!
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Oh, then this must be it!
<<showCharacter "Lina" "SofieSpeakingTired">>
Sofie: Really? Yay! Can I open it now, please?
<<showCharacter "Lina" "SofieListeningTired">>
-> Mailman: Go ahead, it's all yours.
    <<jump AEnd1Day1>>
-> Mailman: I made sure it brings you good luck on your first day.
    <<jump AEnd2Day1>>
===

title: AEnd1Day1
//NEUTRAL
position: -1379,-891
group: FamA && Day1
color: green
---
<<recievePackage true>>
<<set $relationshipFamA += 1>>
<<showCharacter "Lina" "LinaSSpeakingTired">>
Lina: Thank you so much. Have a nice day.
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: You too. Take care!
<<hideCharacter "Lina">>
<<hideBackground>>
===

title: AEnd2Day1
//WARM
position: -1104,-1059
color: green
group: FamA && Day1
---
<<set $relationshipFamA += 2>>
<<showCharacter "Lina" "SofieSpeakingTired">>
Sofie: THANK YOU! It's perfect!
<<showCharacter "Lina" "LinaSSpeakingTired">>
Lina: Thanks again! We'll see you around.
<<showCharacter "Lina" "SofieListeningTired">>
Mailman: Have a wonderful evening, both of you. And good luck tomorrow!
<<hideCharacter "Lina">>
<<hideBackground>>
===

//FAM A — DAY 1 — BACKPACK (BROKEN / FLATTENED)
title: FamA
when: ($day == 1) && ($package == "backpack") && ($packageState == "Broken" || $packageState == "Flattened")
position: -1637,-804
color: purple
group: FamA && Day1
---
<<set $famA_D2_damageCount = 1>>
<<setBackground "BGFamA">>
<<once>>
Mailman: Good afternoon! Are you—
<<showCharacter "Lina" "SpeakingTired">>
Lina: Is that my daughter's package? It's completely crushed!
<<showCharacter "Lina" "ListeningTired">>
Mailman: I'm terribly sorry — it must've been damaged in transport.
<<showCharacter "Lina" "LinaSSpeakingTired">>
Lina: This is unacceptable. She needs that backpack for tomorrow.
-> Mailman: I'll file a report and make sure it's replaced immediately.
    <<jump FamA_D1_Broken_Kind>>
-> Mailman: You can report it to the depot if you'd like.
    <<jump FamA_D1_Broken_Neutral>>
-> Mailman: It left the warehouse fine, these things happen.
    <<jump FamA_D1_Broken_Cold>>
<<else>>
...
<<endonce>>
===
title: FamA_D1_Broken_Kind
group: FamA && Day1
color: green
position: -1112,-751
---
<<set $relationshipFamA += 0>>
<<showCharacter "Lina" "LinaSSpeakingTired">>
Lina: Alright. Please make sure it doesn't happen again.
<<showCharacter "Lina" "LinaListeningTired">>
Mailman: I will. I'm truly sorry. Good evening.
<<hideCharacter "Lina">>
<<hideBackground>>
===

title: FamA_D1_Broken_Neutral
group: FamA && Day1
color: yellow
position: -1108,-891
---
<<set $relationshipFamA -= 1>>
<<showCharacter "Lina" "LinaSSpeakingTired">>
